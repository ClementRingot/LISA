{
  "name": "@lisa-mcp/arc1-extension",
  "version": "0.3.2",
  "description": "LISA SAP-translation tools packaged as an ARC-1 extension (loaded in-process via ARC1_PLUGINS)",
  "keywords": [
    "arc-1",
    "arc1",
    "mcp",
    "sap",
    "translation",
    "i18n",
    "s4hana",
    "plugin",
    "extension"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ClementRingot/LISA.git",
    "directory": "packages/arc1-extension"
  },
  "homepage": "https://github.com/ClementRingot/LISA/tree/main/packages/arc1-extension#readme",
  "bugs": "https://github.com/ClementRingot/LISA/issues",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc --noEmit && node esbuild.config.mjs",
    "prepack": "npm run build",
    "test": "vitest run",
    "lint": "biome check src/",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "arc-1": ">=0.9.20",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@lisa-mcp/core": "*",
    "@types/node": "^26.2.0",
    "arc-1": "^0.9.27",
    "esbuild": "^0.28.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10",
    "zod": "^4.3.6"
  }
}
