{
  "name": "@lisa-mcp/server",
  "version": "0.9.3",
  "description": "LISA — standalone MCP server for SAP object translation (XCO i18n). Deployable on SAP BTP or runnable locally.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "sap",
    "translation",
    "i18n",
    "s4hana",
    "btp",
    "abap",
    "xsuaa"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ClementRingot/LISA.git",
    "directory": "packages/server"
  },
  "homepage": "https://github.com/ClementRingot/LISA#readme",
  "bugs": "https://github.com/ClementRingot/LISA/issues",
  "engines": {
    "node": "22.x"
  },
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "lisa-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "templates",
    ".env.example",
    "README.md",
    "NOTICE",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc --noEmit && node esbuild.config.mjs",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check src/",
    "format": "biome format --write src/",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@arc-mcp/xsuaa-auth": "^1.1.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^5.1.0",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.2.0",
    "jose": "^6.2.12",
    "undici": "^8.10.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@lisa-mcp/core": "*",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^26.6.2",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^4.1.9"
  }
}
